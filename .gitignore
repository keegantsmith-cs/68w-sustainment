# Textbook and reference files are NOT published to the public repo.
# Host them somewhere access-controlled and link to them from js/data.js.
docs/**/*.pdf
docs/**/*.doc
docs/**/*.docx
docs/**/*.ppt
docs/**/*.pptx
docs/**/*.xls
docs/**/*.xlsx

# EXCEPTION: ICTL documents are marked "Approved for public release;
# distribution is unlimited" (Distribution A), so they are published.
# scripts/check.js verifies the statement on every tracked PDF.
!docs/ictl/*.pdf

.DS_Store
Thumbs.db

# Private review notes (not published)
SOURCE_ISSUES_FOR_REVIEW.md

__pycache__/
*.pyc
DRUG_CROSSCHECK_FOR_REVIEW.md

# EXCEPTION: government documents cleared for public posting by the project owner
# (official source, 20 Nov 2026). Listed in docs/PUBLIC_RELEASE.json; check.js enforces it.
!docs/cpg/*.pdf
!docs/adtmc/*.pdf
!docs/smog/*.pdf
